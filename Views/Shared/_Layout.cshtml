<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PivorkJobportal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PivorkJobportal.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-dark bg-success border-bottom box-shadow mb-2 py-2">
            <div class="container-fluid px-4 d-flex justify-content-between align-items-center">

                <!-- Links: Brand-Name + Untertitel -->
                <div class="d-flex flex-column align-items-start">
                    <a class="navbar-brand fw-bold fs-3 text-white m-0 p-0 lh-1" asp-area="" asp-controller="Home" asp-action="Index">Pivork</a>
                    <span class="text-white-50 fst-italic mt-1 text-nowrap" style="font-size: 0.85rem;">
                        wo dein nächster Pivot zu deinem nächsten Job wird.
                    </span>
                </div>
                
                <!-- Rechts: Anmelden Button -->
                <div class="ms-auto flex-shrink-0">
                    <a class="btn btn-outline-light fw-bold px-3 px-md-4 rounded-pill text-nowrap" asp-controller="Auth" asp-action="Identify">
                        Anmelden
                    </a>
                </div>

                <!-- <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button> -->
            </div>
        </nav>
    </header>

    <!-- Hauptinhalt flexibel (stört/überlappt nicht mit dem Footer) -->
    <div class="container flex-grow-1 my-2">
        <main role="main" class="w-100">
            @RenderBody()
        </main>
    </div>

    <!-- Footer ganz unten verankert -->
    <footer class="border-top footer text-muted bg-white py-3 mt-auto w-100" style="position: relative !important;">
       <div class="container">
           &copy; 2026 - PivorkJobportal - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-success fw-bold text-decoration-none"> Privacy</a>
       </div>
   </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
